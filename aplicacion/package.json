{
  "name": "control-emprende",
  "private": true,
  "version": "4.4.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm test && npm run build && npm run build:demo && npm run build:landing",
    "test": "node --test tests/*.test.js",
    "build:demo": "vite build --config vite.demo.config.js && node scripts/package-demo.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "build:landing": "vite build --config vite.landing.config.js && node scripts/package-landing.mjs",
    "test:product-ui": "node scripts/test-product-ui.mjs",
    "test:personalization": "node scripts/test-personalization.mjs",
    "build:desktop:web": "vite build --config vite.desktop.config.js",
    "build:windows": "npm run build:desktop:web && npm --prefix desktop run pack:win",
    "test:desktop": "node --test tests/desktop.test.js",
    "test:desktop-ui": "node scripts/test-licensed-electron.mjs",
    "test:desktop-renderer": "node scripts/test-local-renderer.mjs",
    "test:polish": "node scripts/test-polish.mjs",
    "test:catalog-ui": "node scripts/test-catalog-ui.mjs",
    "test:home-sections": "node scripts/test-home-sections.mjs",
    "test:advisor-score": "node scripts/test-advisor-score.mjs",
    "test:license": "node --test tests/license-client.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
